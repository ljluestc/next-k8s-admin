# Database
DATABASE_URL=postgresql://k8sadmin:k8sadmin@localhost:5432/k8sadmin

# Encryption key for cluster credentials (32 bytes hex)
ENCRYPTION_KEY=

# Session
SESSION_EXPIRY_HOURS=24

# SMTP for email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@k8sadmin.local

# App
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws
NEXT_PUBLIC_DASHBOARD_PANEL_URL=
NEXT_PUBLIC_ARGOCD_PANEL_URL=
NEXT_PUBLIC_ARGOCD_RELEASE_DASHBOARD_URL=
NEXT_PUBLIC_PROMETHEUS_PANEL_URL=
DASHBOARD_TZ_OFFSET_HOURS=8
NEXT_PUBLIC_ISTIO_PANEL_URL=
NEXT_PUBLIC_TRIVY_OPERATOR_PANEL_URL=
NEXT_PUBLIC_FALCO_PANEL_URL=
NEXT_PUBLIC_KYVERNO_PANEL_URL=
NEXT_PUBLIC_GATEKEEPER_PANEL_URL=

# WebSocket server port
WS_PORT=3001
